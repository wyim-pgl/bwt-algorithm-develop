TAG_ROT = {"TAG", "AGT", "GTA", "CTA", "TAC", "ACT"}


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for block in iter(lambda: fh.read(1024 * 1024), b""):
            h.update(block)
    return h.hexdigest()


