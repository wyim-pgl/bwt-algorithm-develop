# Benchmarking environment for BWTandem and its comparator tools.
#
# The manuscript's measured environment is Python 3.11.15 (conda env
# "bwtandem"); this file used to request python=3.13 and force
# CONDA_SUBDIR: osx-64, both of which contradicted every recorded run.
# Core versions are pinned to what the published numbers were measured on --
# see environment.core.lock.yml for the exact core freeze.
name: bwt
channels:
  - conda-forge
  - defaults
  - bioconda
dependencies:
  - python=3.11.15
  - numpy=2.4.6
  - cython=3.2.5
  - pytest=9.1.1
  - pip
  - gcc=14.3.0
  # --- comparator tools and TRASH dependencies (benchmarking only) ---
  - trf
  - tidehunter
  - tantan
  - ncrf
  - r-base
  - r-stringr
  - r-stringi
  - r-stringdist
  - r-optparse
  - r-circlize
  - r-seqinr
  - r-doparallel
  - r-remotes
  - mafft
  - zlib
  - libcurl
  - cmake
  - bioconductor-biostrings
  - bioconductor-pwalign
  - setuptools
  - mreps
  - pip:
      - pydivsufsort==0.0.20
# Exact core freeze of the environment the published numbers were measured on:
# conda env "bwtandem" at /data/gpfs/assoc/pgl/bin/conda/conda_envs/bwtandem,
# recorded 2026-08-27. This is the detector's runtime; comparator tools live in
# environment.yml. numba is NOT installed in the measured environment -- the
# numba-accelerated paths were not part of any recorded run.
name: bwtandem
channels:
  - conda-forge
dependencies:
  - python=3.11.15
  - numpy=2.4.6
  - cython=3.2.5
  - pytest=9.1.1
  - gcc=14.3.0
  - pip
  - pip:
      - pydivsufsort==0.0.20
FROM --platform=linux/amd64 continuumio/miniconda3

LABEL author="Filip Ramazan"
LABEL version="v1.0"
LABEL description="BWTandem — BWT-based tandem repeat finder"

ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8

# gcc: the Cython accelerator compiles at install time, and the four ctypes
# C libraries compile at first import
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential procps \
    && rm -rf /var/lib/apt/lists/*

# The exact pinned core the published numbers were measured on
COPY environment.core.lock.yml /tmp/environment.core.lock.yml
RUN conda env update -n base -f /tmp/environment.core.lock.yml && conda clean -a -y

# Install BWTandem itself (builds the accelerator into the package)
COPY . /opt/bwtandem/
RUN pip install /opt/bwtandem

# Pre-compile the ctypes C libraries into the installed package so read-only
# runtimes (e.g. Singularity converting this image) do not need to write at
# first import
RUN python -m bwtandem.c_extensions.build

ENTRYPOINT ["bwtandem"]
[build-system]
requires = ["setuptools>=77", "wheel", "Cython>=3.0", "numpy>=2.0"]
build-backend = "setuptools.build_meta"

[project]
name = "bwtandem"
version = "0.9.0"
description = "BWT/FM-index based tandem repeat finder with a 3-tier detection pipeline"
readme = "README.md"
requires-python = ">=3.11"
license = "MIT"
license-files = ["LICENSE"]
authors = [{name = "Won C. Yim", email = "woncyim@gmail.com"}]
dependencies = [
    "numpy>=2.0",
    "pydivsufsort==0.0.20",
]

[project.optional-dependencies]
dev = ["pytest>=9", "Cython>=3.0"]

# Declared explicitly so the wheel ships exactly the bwtandem package and its
# c_extensions subpackage. (Historical note: when the import package was still
# named `src`, auto-discovery misread the tree as a src-layout and shipped every
# module top-level, colliding with real distributions such as coverage; keeping
# the explicit list makes the layout an assertion rather than an inference.)
[tool.setuptools]
packages = ["bwtandem", "bwtandem.c_extensions"]

# The four ctypes libraries are compiled AT RUNTIME by c_extensions/build.py
# (dlopen'd by path, not imported), so their C sources must travel in the
# wheel or the installed package silently loses the fast C paths.
[tool.setuptools.package-data]
"bwtandem.c_extensions" = ["*.c"]

[project.scripts]
bwtandem = "bwtandem.main:main"

[tool.pytest.ini_options]
testpaths = ["tests"]

exec
