   124	        # `tolerance_ratio = 0.02 + 0.02 * (max_period / 100000)`: at the
   125	        # default --max-period 2000 the tolerance drops from 0.0400 to 0.0204,
   126	        # so an in-range period can now be grouped differently. min_period
   127	        # likewise affects the seed k-mer size. One full Arabidopsis Chr4 run
   128	        # at default arguments happened to produce byte-identical BED, which
   129	        # does not generalize to other arguments, presets, or genomes.
   130	        tier3_min = max(100, self.min_period)
   131	        tier3_max = min(100_000, self.max_period)
   132	        self.tier3 = None
   133	        if "tier3" in self.enabled_tiers and tier3_min <= tier3_max:
   134	            self.tier3 = Tier3LongReadFinder(
   135	                self.bwt,
   136	                min_length=tier3_min,
   137	                max_length=tier3_max,
   138	                mode=tier3_mode,
   139	            )
   140	
   141	        # Satellite gap-fill tuning (env-overridable). Defaults are the improved
   142	        # operating point that recovers divergent-alpha-sat interior gaps which
   143	        # the 3-tier pipeline leaves uncovered between large-HOR-motif calls.
   144	        # SAT_FILL_MIN_IDENTITY: min autocorrelation identity to accept a gap as
   145	        #   satellite (0.45 captures ~46%-identity divergent alpha-sat; ~2.5x
   146	        #   above the ~0.18 autocorrelation floor of non-repetitive DNA).
   147	        # SAT_ANCHOR_MIN_MOTIF / SAT_ANCHOR_MAX_MOTIF: motif-length window for a
   148	        #   repeat to count as a satellite anchor whose neighbourhood is scanned
   149	        #   for uncovered gaps. MAX=0 means no upper bound, so large HOR-unit
   150	        #   calls (motif >> 300bp) also anchor gap scanning.
   151	        self.sat_fill_min_identity = float(os.environ.get("SAT_FILL_MIN_IDENTITY", "0.45"))
   152	        self.sat_anchor_min_motif = int(os.environ.get("SAT_ANCHOR_MIN_MOTIF", "100"))
   153	        self.sat_anchor_max_motif = int(os.environ.get("SAT_ANCHOR_MAX_MOTIF", "0"))
   154	        # Period window for the gap autocorrelation scan. Default 100-360 covers
   155	        # the alpha-satellite monomer (171bp) and the dimeric HOR period
   156	        # (2x171=342) where highly divergent arrays (e.g. chr3, ~46% monomer
   157	        # identity) carry their strongest periodic signal. The 0.45 identity
   158	        # floor stays ~2.5x above the ~0.18 autocorrelation of non-repetitive DNA.
   159	        self.sat_fill_min_period = int(os.environ.get("SAT_FILL_MIN_PERIOD", "100"))
   160	        self.sat_fill_max_period = int(os.environ.get("SAT_FILL_MAX_PERIOD", "360"))
   161	
   162	    def find_all(self) -> List[TandemRepeat]:
   163	        """Execute the full 3-tier finding pipeline."""
   164	        all_repeats = []  # List to collect repeats found across all tiers
   165	        tier1_seen: Set[Tuple[int, int]] = set()  # Set of (start, end) coordinates found by Tier 1 (for deduplication)
   166	        tier2_seen: Set[Tuple[int, int]] = set()  # Set of (start, end) coordinates found by Tier 2 (for deduplication)
   167	
   168	        # --- Tier 1: Short Perfect Repeats ---
   169	        if self.tier1:
   170	            if self.show_progress:
   171	                # Print Tier 1 start notification
   172	                print(f"  [{self.chromosome}] Running Tier 1 (Short Perfect)...", flush=True)
   173	            t0 = time.time()  # Record Tier 1 start time
   174	            tier1_repeats = self.tier1.find_strs(self.chromosome)  # Run Tier 1: find short perfect repeats
   175	
   176	            accepted = 0  # Counter for repeats that pass the filter
   177	            for r in tier1_repeats:
   178	                # Register each repeat in the global list (with array length range filter)
   179	                if self._register_repeat(r, all_repeats, tier1_seen):
   180	                    accepted += 1  # Increment counter on successful registration
   181	
   182	            if self.show_progress:
   183	                # Print Tier 1 completion and results summary
   184	                print(f"  [{self.chromosome}] Tier 1 found {accepted} repeats in {time.time() - t0:.2f}s", flush=True)
   185	        elif self.show_progress:
   186	            # Notify if Tier 1 is disabled or out of requested range
   187	            print(f"  [{self.chromosome}] Skipping Tier 1 (disabled or out of requested range)", flush=True)
   188	
   189	        # --- Tier 2: Imperfect & Medium Repeats (>=10bp by design) ---
   190	        if self.tier2:
   191	            if self.show_progress:
   192	                # Print Tier 2 start notification
   193	                print(f"  [{self.chromosome}] Running Tier 2 (Imperfect & Medium)...", flush=True)
   194	            t0 = time.time()  # Record Tier 2 start time
   195	            # 2a. Long unit repeats (strict adjacency, >=20bp units)
   196	            long_unit_repeats = []  # List for long unit repeat results
   197	            long_kept = 0  # Count of registered long unit repeats
   198	            min_unit = max(20, self.min_period)  # Minimum motif length for Tier 2 long unit repeats (at least 20 bp)
   199	            if self.max_period >= min_unit:
   200	                # Only run long unit repeat search when max period is at least min_unit
   201	                long_unit_repeats = self.tier2.find_long_unit_repeats_strict(
   202	                    self.chromosome,          # Chromosome name
   203	                    min_unit_len=min_unit,    # Minimum unit length
   204	                    max_unit_len=self.max_period,  # Maximum unit length
   205	                    min_copies=2              # Minimum copy count of 2
   206	                )
   207	
   208	                for r in long_unit_repeats:
   209	                    is_new = True  # Initialize flag for whether this is a new repeat
   210	                    for start, end in tier1_seen:
   211	                        # Check if it overlaps with positions already found by Tier 1
   212	                        if not (r.end <= start or r.start >= end):
   213	                            is_new = False  # Not new if overlapping
   214	                            break
   215	                    if is_new and self._register_repeat(r, all_repeats, tier2_seen):
   216	                        long_kept += 1  # Increment counter if new and successfully registered
   217	
   218	            # 2b. General scanning for medium/long repeats up to requested max
   219	            medium_repeats = []  # List for medium-length repeat results
   220	            medium_kept = 0  # Count of registered medium-length repeats
   221	            # Force Tier2 to ignore classic microsatellites: start from period 10bp
   222	            scan_lower = max(10, self.min_period)   # Scan lower bound: at least 10 bp to exclude microsatellites
   223	            scan_upper = min(50, self.max_period)   # Scan upper bound: up to 50 bp (BWT seed method range)
   224	            if scan_upper >= scan_lower:
   225	                # Only run when there is a valid scan range
   226	                combined_seen = tier1_seen.union(tier2_seen)  # Union of positions already found by Tier 1 and Tier 2
   227	                medium_repeats = self.tier2.find_long_repeats(
   228	                    self.chromosome,          # Chromosome name
   229	                    combined_seen,            # Already-found position set for deduplication
   230	                    max_scan_period=scan_upper  # Maximum scan period
   231	                )
   232	
   233	                for r in medium_repeats:
   234	                    # Register medium-length repeats
   235	                    if self._register_repeat(r, all_repeats, tier2_seen):
   236	                        medium_kept += 1  # Increment counter on successful registration
   237	            if self.show_progress:
   238	                total_kept = long_kept + medium_kept  # Total of long unit and medium-length repeats
   239	                # Print Tier 2 completion and results summary
   240	                print(f"  [{self.chromosome}] Tier 2 processed {total_kept} repeats (>=10bp motifs) in {time.time() - t0:.2f}s", flush=True)
   241	        elif self.show_progress:
   242	            # Notify if Tier 2 is disabled
   243	            print(f"  [{self.chromosome}] Skipping Tier 2 (disabled)", flush=True)
   244	
   245	        # --- Tier 3: Long Reads (Optional/Advanced) ---
   246	        if self.tier3:
   247	            if self.show_progress:
   248	                # Print Tier 3 start notification
   249	                print(f"  [{self.chromosome}] Running Tier 3 (Long Reads)...", flush=True)
   250	            t0 = time.time()  # Record Tier 3 start time
   251	
   252	            combined_seen = tier1_seen.union(tier2_seen)  # Union of Tier 1 + Tier 2 found positions (for Tier 3 deduplication)
   253	            tier3_repeats = self.tier3.find_long_repeats(
   254	                self.chromosome,  # Chromosome name
   255	                tier1_seen,       # Tier 1 found position set
   256	                tier2_seen        # Tier 2 found position set
   257	            )
   258	
   259	            accepted = 0  # Counter for repeats registered from Tier 3
   260	            for r in tier3_repeats:
   261	                # Register Tier 3 results in the global list
   262	                if self._register_repeat(r, all_repeats, combined_seen):
   263	                    accepted += 1  # Increment counter on successful registration
   264	
   265	            if self.show_progress:
   266	                # Print Tier 3 completion and results summary
   267	                print(f"  [{self.chromosome}] Tier 3 found {accepted} repeats in {time.time() - t0:.2f}s", flush=True)
   268	        elif self.show_progress:
   269	            # Notify if Tier 3 is disabled
   270	            print(f"  [{self.chromosome}] Skipping Tier 3 (disabled)", flush=True)
   271	
   272	        # --- Post-processing ---
   273	        all_repeats.sort(key=lambda x: x.start)
   274	
   275	        if self.show_progress:
   276	            t0 = time.time()
   277	        all_repeats = self._merge_adjacent_repeats(all_repeats)
   278	        if self.show_progress:
   279	            print(f"  [{self.chromosome}] Merge: {time.time() - t0:.2f}s, {len(all_repeats)} repeats", flush=True)
   280	            t0 = time.time()
   281	        final_repeats = self._filter_overlaps(all_repeats)
   282	        if self.show_progress:
   283	            print(f"  [{self.chromosome}] Filter: {time.time() - t0:.2f}s, {len(final_repeats)} repeats", flush=True)
   284	
   285	        # Satellite DNA scanner (multiple passes)
   286	        for pass_num in range(2):
   287	            if self.show_progress:
   288	                t0 = time.time()
   289	            prev_count = len(final_repeats)
   290	            final_repeats = self._fill_satellite_gaps(final_repeats)
   320	        # Sort by start position
   321	        repeats.sort(key=lambda x: x.start)  # Sort by start position
   322	
   323	        filtered = [repeats[0]]  # Add the first repeat to the result list
   324	
   325	        for current in repeats[1:]:
   326	            prev = filtered[-1]  # Last retained repeat so far
   327	
   328	            # Check overlap
   329	            if current.start < prev.end:
   330	                # Two repeats overlap; calculate the overlap amount
   331	                overlap = min(prev.end, current.end) - max(prev.start, current.start)  # Actual overlapping bp count
   332	                overlap_ratio = overlap / min(prev.length, current.length)  # Overlap ratio relative to the shorter one
   333	
   334	                if overlap_ratio > 0.5:  # Significant overlap
   335	                    # Keep the higher-scoring repeat. Score = length * (1 - mismatch_rate)
   336	                    prev_score = prev.length * (1.0 - prev.mismatch_rate)   # Calculate score for previous repeat
   337	                    curr_score = current.length * (1.0 - current.mismatch_rate)  # Calculate score for current repeat
   338	
   339	                    if curr_score > prev_score:
   340	                        filtered[-1] = current  # If current is better, replace previous with current
   341	                else:
   342	                    # Small overlap; keep both repeats (may be a compound repeat)
   343	                    filtered.append(current)
   344	            else:
   345	                filtered.append(current)  # No overlap; add as-is
   346	
   347	        return filtered  # Return filtered list of repeats
   348	
   349	    def _merge_adjacent_repeats(self, repeats: List[TandemRepeat]) -> List[TandemRepeat]:
   350	        """Merge adjacent repeats with the same motif."""
   351	        if not repeats:
   352	            return []  # Return empty list if input is empty
   353	
   354	        # Sort by start position
   355	        repeats.sort(key=lambda x: x.start)  # Sort by start position
   356	
   357	        merged = [repeats[0]]  # Start merge result list with the first repeat
   358	
   359	        for current in repeats[1:]:
   360	            prev = merged[-1]  # Last merged item so far
   361	
   362	            # Check if they are adjacent or overlapping
   363	            # Allow a small gap (e.g., up to period length or 10bp)
   364	            gap = max(0, current.start - prev.end)  # Gap between two repeats (clamped to non-negative)
   365	
   366	            # Check if motifs are compatible (same canonical motif)
   367	            motif1 = prev.consensus_motif or prev.motif    # Consensus motif or original motif of the previous item
   368	            motif2 = current.consensus_motif or current.motif  # Consensus motif or original motif of the current item
   369	
   370	            canon1, _ = MotifUtils.get_canonical_motif_stranded(motif1)  # Canonical form of previous motif (strand unused here)
   371	            canon2, _ = MotifUtils.get_canonical_motif_stranded(motif2)  # Canonical form of current motif (strand unused here)
   372	
   373	            # Allow merge if canonical motifs match and gap is small
   374	            # For long-period repeats (satellite DNA), allow larger gaps
   375	            # since individual repeat units can be ~178bp with imperfect boundaries
   376	            period_len = len(canon1)
   377	            if period_len >= 100:
   378	                max_gap = period_len * 100  # e.g. 17.8kb for CEN180
   379	            elif period_len >= 20:
   380	                max_gap = period_len * 10
   381	            else:
   382	                max_gap = max(10, period_len)
   383	            # For long-period repeats, use fuzzy canonical motif matching
   384	            # (satellite DNA consensus can drift between adjacent regions)
   385	            motifs_match = (canon1 == canon2)
   386	            if not motifs_match and len(canon1) == len(canon2) and len(canon1) >= 50:
   387	                hamming = sum(1 for a, b in zip(canon1, canon2) if a != b)
   388	                motifs_match = (hamming / len(canon1)) <= 0.10  # 10% tolerance
   389	            if motifs_match and gap <= max_gap:
   390	                # Trial merge: check if combined region quality is acceptable
   391	                new_start = min(prev.start, current.start)
   392	                new_end = max(prev.end, current.end)
   393	                avg_mm = (prev.mismatch_rate + current.mismatch_rate) / 2
   394	
   395	                # Quality check for merge
   396	                text_arr = self.bwt.text_arr
   397	                actual_motif = motif1
   398	                mlen = len(actual_motif)
   399	                merge_ok = False
   400	
   401	                if mlen >= 100 and gap > mlen:
   402	                    # Satellite DNA: check periodicity of gap region via autocorrelation
   403	                    gap_start_pos = prev.end
   404	                    gap_end_pos = current.start
   405	                    gap_seq = text_arr[gap_start_pos:gap_end_pos]
   406	                    if len(gap_seq) >= mlen * 2:
   407	                        merge_ok = autocorr_identity(gap_seq, mlen) >= 0.55
   408	                else:
   409	                    # Short repeats: use direct motif comparison
   410	                    motif_arr = np.frombuffer(actual_motif.encode('ascii'), dtype=np.uint8)
   411	                    trial_mismatches = 0
   412	                    trial_total = 0
   413	                    for pos in range(new_start, min(new_end, len(text_arr) - mlen), mlen):
   414	                        window = text_arr[pos:pos + mlen]
   415	                        if len(window) == mlen:
   416	                            trial_mismatches += np.sum(window != motif_arr)
   417	                            trial_total += mlen
   418	                    trial_mm = trial_mismatches / trial_total if trial_total > 0 else 0
   419	                    max_acceptable_mm = max(avg_mm * 2, 0.15)
   420	                    merge_ok = trial_mm <= max_acceptable_mm
   421	
   422	                if merge_ok:
   423	                    prev.start = new_start
   424	                    prev.end = new_end
   425	                    prev.length = new_end - new_start
   426	                    prev.copies = prev.length / len(canon1)
   427	                    # Skip expensive stats recomputation for very large regions
   428	                    if prev.length <= 50000:
   429	                        self._recompute_stats(prev)
   430	                else:
   431	                    # Mismatch too high after merge — keep as separate repeats
   432	                    merged.append(current)
   433	
   434	            else:
   435	                merged.append(current)  # Merge conditions not met; add as a separate item
   436	
   437	        return merged  # Return the merged list of repeats
   438	
   439	    def _recompute_stats(self, repeat: TandemRepeat):
   440	        """Recompute statistics for a repeat (e.g. after merging)."""
   441	        text_arr = self.bwt.text_arr  # Reference the byte array sequence from the FM-index
   442	        motif = repeat.consensus_motif or repeat.motif  # Use consensus motif or original motif
   443	        motif_len = len(motif)  # Calculate motif length
   444	
   445	        if motif_len == 0:
   446	            return  # Cannot compute statistics with zero-length motif; return immediately
   447	
   448	        # Re-derive consensus and mismatch rate from the entire merged region
   449	        consensus_arr, mm_rate, max_mm = MotifUtils.build_consensus_motif_array(
   450	            text_arr, repeat.start, motif_len, int(repeat.copies)
   451	        )
   452	
   453	        if consensus_arr.size > 0:
   454	            # Decode consensus array to ASCII string
   455	            consensus_str = consensus_arr.tobytes().decode('ascii', errors='replace')
   456	            repeat.consensus_motif = consensus_str  # Update consensus motif
   457	            repeat.motif = consensus_str # Update motif to new consensus
   458	            repeat.mismatch_rate = mm_rate  # Update mismatch rate
   459	            repeat.max_mismatches_per_copy = max_mm  # Update maximum mismatches per copy
   460	
   461	            # Recalculate TRF-compatible statistics
   462	            (percent_matches, percent_indels, score, composition,
   463	             entropy, actual_sequence) = MotifUtils.calculate_trf_statistics(
   464	                text_arr, repeat.start, repeat.end, consensus_str, int(repeat.copies), mm_rate
   465	            )
   466	
   467	            repeat.percent_matches = percent_matches  # Update match percentage
   468	            repeat.percent_indels = percent_indels    # Update indel percentage
   469	            repeat.score = score                      # Update TRF score
   470	            repeat.composition = composition          # Update base composition
   471	            repeat.entropy = entropy                  # Update Shannon entropy
   472	            repeat.actual_sequence = actual_sequence  # Update actual sequence string
   473	
   474	            # Update per-copy variation summary
   475	            variations = MotifUtils.summarize_variations_array(
   476	                text_arr, repeat.start, repeat.end, motif_len, consensus_arr
   477	            )
   478	            repeat.variations = variations  # Update variation information
   479	
   480	    def _fill_satellite_gaps(self, repeats: List[TandemRepeat]) -> List[TandemRepeat]:
   481	        """Scan for satellite DNA regions not covered by existing detections.
   482	
   483	        Uses autocorrelation on uncovered regions to find periodic satellite DNA
   484	        (e.g., CEN180) that may have been missed by the 3-tier pipeline due to
   485	        high inter-copy divergence.
   486	        """
   487	        text_arr = self.bwt.text_arr
   488	        # `text_arr` carries the BWT sentinel, so len() is one past the last real
   489	        # base. Scanning to it let a terminal gap be reported with end == seqlen+1
   490	        # — a BED interval past the end of its chromosome, which is malformed for
   491	        # bedtools — and let `$` into the motif. `_catchall_periodicity_fill`
   492	        # already uses effective_length for the same reason.
   493	        n = effective_length(text_arr)
   494	
   495	        if n < 1000:
   496	            return repeats
   497	
   498	        covered = mask_from_repeats(repeats, n)
   499	
   500	        # Find uncovered blocks >= 300bp
   501	        gap_starts, gap_ends = contiguous_true_runs(~covered)
   502	        uncovered_blocks = [(int(s), int(e)) for s, e in zip(gap_starts, gap_ends) if e - s >= 300]
   503	
   504	        if not uncovered_blocks:
   505	            return repeats
   506	
   507	        # Collect satellite motifs and positions from existing long-period repeats
   508	        satellite_positions = []
   509	        for r in repeats:
   510	            m = r.consensus_motif or r.motif
   511	            if not m or len(m) < self.sat_anchor_min_motif:
   512	                continue
   513	            if self.sat_anchor_max_motif and len(m) > self.sat_anchor_max_motif:
   514	                continue
   515	            satellite_positions.append((r.start, r.end))
   516	
   517	        # Build a proximity mask: only scan blocks near satellite regions
   518	        # This avoids scanning the entire non-centromeric sequence
   519	        near_satellite = np.zeros(n, dtype=bool)
   520	        proximity = 50000  # 50kb proximity window
   521	        for sat_start, sat_end in satellite_positions:
   522	            near_satellite[max(0, sat_start - proximity):min(n, sat_end + proximity)] = True
   523	
   524	        new_repeats = []
   525	        block_valid = valid_base_mask(text_arr[:n])
   526	        for block_start, block_end in uncovered_blocks:
   527	            block_size = block_end - block_start
   528	            if block_size > 100000 or block_size < 300:
   529	                continue
   530	
   531	            # Skip blocks not near existing satellite detections
   532	            if not np.any(near_satellite[block_start:block_end]):
   533	                continue
   534	
   535	            # Periodicity is judged from at most three 5 kb windows but the
   536	            # whole block gets claimed, so a block that is mostly assembly gap
   537	            # or masked sequence must not be labelled satellite on the strength
   538	            # of one real-sequence window at its edge.
   539	            valid_frac = float(np.count_nonzero(
   540	                block_valid[block_start:block_end])) / block_size
   541	            if valid_frac < DEFAULT_MIN_VALID_FRAC:
   542	                continue
   543	
   544	            # Autocorrelation-based satellite detection
   545	            # Scan multiple windows: start, middle, end of block
   546	            windows = [(block_start, min(block_start + 5000, block_end))]
   547	            if block_size > 5000:
   548	                mid = block_start + block_size // 2 - 2500
   549	                windows.append((mid, min(mid + 5000, block_end)))
   550	                windows.append((max(block_start, block_end - 5000), block_end))
   551	
   552	            best_period = 0
   553	            best_identity = 0.0
   554	            best_w_start = block_start
   555	
   556	            for w_start, w_end in windows:
   557	                w_region = text_arr[w_start:w_end]
   558	                w_size = len(w_region)
   559	                if w_size < 300:
   560	                    continue
   561	
   562	                for p in range(self.sat_fill_min_period, min(self.sat_fill_max_period + 1, w_size // 2)):
   563	                    identity = autocorr_identity(w_region, p)
   564	                    if identity > best_identity:
   565	                        best_identity = identity
   566	                        best_period = p
   567	                        best_w_start = w_start
   568	                        if identity > 0.80:
   569	                            break
   570	                if best_identity > 0.80:
   571	                    break
   572	
   573	            if best_identity < self.sat_fill_min_identity or best_period < 50:
   574	                continue
   575	
   576	            use_motif = text_arr[best_w_start:best_w_start + best_period].tobytes().decode('ascii', errors='replace')
   577	            # The motif is a raw window off the text, so an assembly gap or the
   578	            # sentinel would otherwise be reported as the repeat unit. An N-run is
   579	            # trivially "periodic" (N == N), which is how motifs of solid Ns got
   580	            # emitted at telomeres. Same guard the catch-all pass applies.
   581	            if not use_motif or any(c not in 'ACGT' for c in use_motif):
   582	                continue
   583	
   584	            # The sampled windows only *nominate* a period. Claiming
   585	            # [block_start, block_end) on their strength alone let one periodic
   586	            # 5 kb edge window label up to 100 kb of unexamined sequence as
   587	            # satellite. Verify the periodicity across the whole block instead
   588	            # and emit only the contiguous stretches that actually support it.
   589	            new_repeats.extend(self._segment_periodic_block(
   590	                text_arr, block_start, block_end, best_period))
   591	
   592	        if new_repeats:
   593	            filled = list(repeats) + new_repeats
   594	            filled.sort(key=lambda x: x.start)
   595	            return filled
   596	
   597	        return repeats
   598	
   599	    def _segment_periodic_block(self, text_arr: np.ndarray, block_start: int,
   600	                                block_end: int, period: int) -> List[TandemRepeat]:
