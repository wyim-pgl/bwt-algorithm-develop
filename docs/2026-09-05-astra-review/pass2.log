    13	def compute_adaptive_params(
    14	    seq_len: int,        # Input sequence length (bp)
    15	    gc_content: float,   # GC content (range 0 to 1)
    16	    coverage_ratio: float,  # Fraction of sequence already covered by other tiers
    17	    min_period: int,     # Minimum repeat unit length
    18	    max_period: int,     # Maximum repeat unit length
    19	    preset: str = "balanced",  # Speed/sensitivity preset ("fast", "balanced", "sensitive")
    20	) -> dict:
    21	    """Compute adaptive Tier 3 parameters based on input characteristics."""
    22	    # Speed weight per preset: fast=faster (lower sensitivity), sensitive=slower (higher sensitivity)
    23	    speed_weights = {"fast": 0.8, "balanced": 0.5, "sensitive": 0.2}
    24	    speed_weight = speed_weights.get(preset, 0.5)  # Extract weight for the preset (default 0.5 if not found)
    25	    speed_factor = speed_weight / 0.5  # Relative speed multiplier compared to balanced (0.5)
    26	
    27	    # Compute base parameters using continuous functions (log-scaled by sequence length)
    28	    safe_seq = max(seq_len, 1)  # Lower bound to prevent division by zero
    29	
    30	    base_kmer = int(10 + 6 * math.log10(max(safe_seq / 1e5, 1)))  # k-mer size: larger k-mers for longer sequences
    31	    base_stride = int(safe_seq / 40000)  # Sampling stride: proportional to sequence length
    32	    base_max_occ = int(safe_seq / 30000)  # Max allowed k-mer occurrences: filters out low-complexity high-frequency k-mers
    33	    base_scan_bw = int(50 * safe_seq / 1e8)  # Backward scan range (in repeat units)
    34	    base_scan_fw = int(600 * safe_seq / 1e8)  # Forward scan range (in repeat units)
    35	
    36	    # Accuracy parameters: depend only on sequence characteristics, not preset
    37	    allowed_mismatch_rate = 0.15 + 0.10 * abs(gc_content - 0.5)  # Higher mismatch tolerance for extreme GC content
    38	    tolerance_ratio = 0.02 + 0.02 * (max_period / 100000)  # Wider period tolerance for larger max periods
    39	    anchor_match_pct = 0.70 + 0.10 * (1 - coverage_ratio)  # Relax anchor matching threshold when coverage is low
    40	
    41	    # Apply preset multiplier to speed parameters
    42	    kmer_size = int(base_kmer + (speed_factor - 1) * 2)  # Fast mode increases k-mer size (fewer hits)
    43	    stride = int(base_stride * speed_factor)  # Fast mode uses larger stride for sparser sampling
    44	    max_occurrences = int(base_max_occ / speed_factor)  # Fast mode allows fewer high-frequency k-mers
    45	    scan_backward = int(base_scan_bw / speed_factor)  # Fast mode scans shorter backward range
    46	    scan_forward = int(base_scan_fw / speed_factor)  # Fast mode scans shorter forward range
    47	
    48	    # When coverage exceeds 50%, reduce stride to scan uncovered regions more finely
    49	    if coverage_ratio > 0.5:
    50	        stride = int(stride * (1 - 0.5 * coverage_ratio))  # Higher coverage leads to smaller stride
    51	
    52	    # Strategy adjustments by sequence size range
    53	    if safe_seq > 100_000_000:  # Over 100 Mbp: large chromosome mode
    54	        stride = max(stride, 150)  # Ensure minimum stride to avoid excessive slowdown
    55	        kmer_size = max(kmer_size, 20)  # Use longer k-mers for specificity on large sequences
    56	        max_occurrences = min(max_occurrences, 500)  # Tighten upper bound to filter low-complexity repeats
    57	    elif safe_seq < 100_000:  # Under 100 kbp: micro mode (short sequences)
    58	        stride = max(stride, 20)  # Maintain minimum sampling stride even for short sequences
    59	        kmer_size = max(kmer_size, 12)  # Ensure minimum k-mer size for short sequences
    60	
    61	    # Clamp all parameters to allowed ranges
    62	    kmer_size = max(12, min(28, kmer_size))  # k-mer size: restricted to 12-28 bp
    63	    stride = max(20, min(300, stride))  # Sampling stride: restricted to 20-300
    64	    allowed_mismatch_rate = max(0.15, min(0.20, allowed_mismatch_rate))  # Mismatch rate: 15%-20%
    65	    tolerance_ratio = max(0.02, min(0.04, tolerance_ratio))  # Period tolerance: 2%-4%
    66	    max_occurrences = max(200, min(1500, max_occurrences))  # Max occurrences: 200-1500
    67	    anchor_match_pct = max(0.70, min(0.80, anchor_match_pct))  # Anchor match ratio: 70%-80%
    68	    scan_backward = max(20, min(80, scan_backward))  # Backward scan: 20-80 units
    69	    scan_forward = max(200, min(800, scan_forward))  # Forward scan: 200-800 units
