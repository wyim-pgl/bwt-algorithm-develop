#!/bin/bash
#SBATCH --job-name=seedabl
#SBATCH --nodes=1 --ntasks=1 --cpus-per-task=4 --mem=64G --time=24:00:00
#SBATCH --output=/data/gpfs/assoc/pgl/devel/exp1_human/wp0/fixcampaign/seedabl/seedabl_%j.log
# REV-2: the paper attributes its cost profile to FM-index seeding, and no arm
# isolates that. This is the arm. Tier 2 and Tier 3 both seed through
# bwt_seed.bwt_kmer_seed_scan, whose only use of the index is to turn a sampled
# k-mer into its occurrence positions. BWT_SEED_KTUPLE=1 answers that same
# question from a sorted 2-bit k-tuple table built in one pass instead, so the
# two arms sample the same k-mers, get the same positions, and run the same
# extension and refinement. Output must be identical; only cost may differ.
#
# Paired by construction: both arms run on one node, back to back, at the
# published Arabidopsis configuration (Supplementary Methods S2, "Main run,
# Arabidopsis": MAXP 2000, catch-all off). Arabidopsis is the genome REV-2 asks
# for one of, and is the only one where a whole-genome pair fits the wall clock.
#
# Note what this does and does not isolate. It isolates the seeding data
# structure inside Tiers 2 and 3. Tier 1's FM-index enumeration mode is a
# separate mechanism and is left on in both arms, so this is not a
# whole-pipeline index ablation and must not be described as one.
set -uo pipefail
W=/data/gpfs/assoc/pgl/devel/exp1_human/wp0/fixcampaign
PY=/data/gpfs/assoc/pgl/bin/conda/conda_envs/bwtandem/bin/python
FA=/data/gpfs/assoc/pgl/filip/bwt/colcen/colcen.fa
O="$W/seedabl"
cd "$W/tree_seedabl"
echo "START $(date) HOST $(hostname)"

# Published Arabidopsis configuration: the shared gate base plus the relaxed
# short-period gate; catch-all stays off.
export TIER1_FMSCAN=1 TIER1_FMSCAN_MIN_DENSITY=0.45 TIER1_FMSCAN_MIN_LLR=6.0 \
       TIER1_MIN_ARRAY_LEN=20 TIER1_MIN_SCORE=20 TIER1_MIN_COPIES=2 \
       TIER1_COPYBASE=6 TIER1_COPYADD=2 TIER1_EXT_COPIES=2 \
       TIER2_MISMATCH=0.30 TIER2_SHORT_REQ_COPIES=2 \
       TIER1_SHORT_PERIOD_MAX=9 TIER1_SHORT_MIN_ARRAY_LEN=17 TIER1_SHORT_MIN_SCORE=17
echo "--- knobs ---"; env | grep -E '^(TIER[123]|CATCHALL|SAT_|BWT_SEED)' | sort

for ARM in index ktuple; do
  case "$ARM" in
    index)  export BWT_SEED_KTUPLE=0 ;;
    ktuple) export BWT_SEED_KTUPLE=1 ;;
  esac
  echo "############ ARM=$ARM BWT_SEED_KTUPLE=$BWT_SEED_KTUPLE ############"
  /usr/bin/time -v "$PY" -m src.main "$FA" --min-period 1 --max-period 2000 \
    --threads 4 --format bed -o "$O/abl_$ARM" > "$O/abl_$ARM.stdout" 2> "$O/abl_$ARM.time"
  echo "exit=$? calls=$(wc -l < "$O/abl_$ARM.bed" 2>/dev/null || echo NA)"
  grep -E "Elapsed \(wall|Maximum resident" "$O/abl_$ARM.time" || true
done

echo "=== output equality (the precondition for reading the cost difference) ==="
if cmp -s "$O/abl_index.bed" "$O/abl_ktuple.bed"; then
  echo "IDENTICAL"
else
  echo "DIFFERENT -- the arms are not comparable; report the difference, not the cost"
  diff "$O/abl_index.bed" "$O/abl_ktuple.bed" | head -20
fi
echo "DONE $(date)"

