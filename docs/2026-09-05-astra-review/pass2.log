    22	class KTupleTable:
    23	    """Sorted k-tuple table: the non-index way to answer "where does this k-mer occur".
    24	
    25	    Exists for the seeding ablation (BWT_SEED_KTUPLE), which asks what the
    26	    FM-index buys the seeding step. It answers the same question as
    27	    backward_search plus a suffix-array slice and must return the same position
    28	    set, so the only thing that differs between the two arms is cost.
    29	
    30	    Every k-mer of the text is 2-bit encoded into one uint64 (k <= 32), the codes
    31	    are sorted once, and a lookup is a pair of binary searches over that sorted
    32	    array. Positions containing a base other than A, C, G or T are excluded, as
    33	    the FM-index path excludes them at its own k-mer filter.
    34	    """
    35	
    36	    _CODE = np.full(256, 255, dtype=np.uint8)
    37	    for _b, _v in ((b"A", 0), (b"C", 1), (b"G", 2), (b"T", 3)):
    38	        _CODE[_b[0]] = _v
    39	        _CODE[_b.lower()[0]] = _v
    40	
    41	    def __init__(self, text_arr: np.ndarray, k: int, n: int):
    42	        if k > 32:
    43	            raise ValueError(f"KTupleTable supports k <= 32, got {k}")
    44	        self.k = k
    45	        codes = self._CODE[text_arr[:n]]
    46	        valid = codes != 255
    47	        # A k-mer is usable only if all k of its bases are valid; a rolling
    48	        # minimum over the validity flags is the cheapest way to say that.
    49	        ok = valid[: n - k + 1].copy()
    50	        for off in range(1, k):
    51	            ok &= valid[off : n - k + 1 + off]
    52	        packed = np.zeros(n - k + 1, dtype=np.uint64)
    53	        safe = np.where(valid, codes, 0).astype(np.uint64)
    54	        for off in range(k):
    55	            packed <<= np.uint64(2)
    56	            packed |= safe[off : n - k + 1 + off]
    57	        self._pos = np.flatnonzero(ok).astype(np.int64)
    58	        self._key = packed[self._pos]
    59	        order = np.argsort(self._key, kind="stable")
    60	        self._key = self._key[order]
    61	        self._pos = self._pos[order]
    62	
    63	    def encode(self, kmer: str) -> Optional[int]:
    64	        code = 0
    65	        for ch in kmer:
    66	            v = self._CODE[ord(ch)]
    67	            if v == 255:
    68	                return None
    69	            code = (code << 2) | int(v)
    70	        return code
    71	
    72	    def positions(self, kmer: str) -> Optional[np.ndarray]:
    73	        """Every start position of `kmer`, or None if it contains a non-ACGT base."""
    74	        code = self.encode(kmer)
    75	        if code is None:
    76	            return None
    77	        lo = int(np.searchsorted(self._key, np.uint64(code), side="left"))
    78	        hi = int(np.searchsorted(self._key, np.uint64(code), side="right"))
    79	        return self._pos[lo:hi]
    80	
