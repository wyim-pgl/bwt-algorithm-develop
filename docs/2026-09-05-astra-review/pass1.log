/bin/bash -lc "python3 - <<'PY'
import csv,pathlib,collections,subprocess,hashlib,json
rows=list(csv.DictReader(open('results/manifest.tsv'),delimiter='\\t'))
for k in ['scorer','scorer_sha','repo_commit']:
 print(k,dict(collections.Counter(r[k] for r in rows)))
for i,r in enumerate(rows,2):
 if not pathlib.Path(r['source_bed']).is_file(): print('NONFILE',i,r['table'],r['row'],r['source_bed'])
for fn in ['results/manifest.sha256','results/external_evidence.sha256']:
 pairs=[l.rstrip('\\n').split(None,1) for l in open(fn) if l.strip()]; paths={p for h,p in pairs}
 print(fn,'entries',len(pairs),'missing',[p for p in paths if not pathlib.Path(p).is_file()])
 if 'external' not in fn: print('UNLISTED',sorted(str(p) for p in pathlib.Path('results').rglob('*') if p.is_file() and str(p) not in paths))
print('README inventory',[str(p) for p in pathlib.Path('results').rglob('*') if p.is_file() and 'readme' in p.name.lower()])
