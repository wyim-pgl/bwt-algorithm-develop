+        assert abs(out[p.name]['sensitivity']-d['sensitivity_1to1_maxcard']) < 1e-8
+        assert abs(out[p.name]['precision']-d['precision_1to1_maxcard']) < 1e-8
+    fn = 'results/one_to_one/one_to_one_trf_annot_r50.json'
